# ============================================================================
# DRUNK // 10K — Git Ignore & Security Hygiene Policy
# Referência Técnica: docs/GITIGNORE_AND_SECURITY_SPECS.md
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Credenciais, Chaves de API, Segredos e Configurações de Agentes/MCP
# (NUNCA versionar chaves, tokens ou arquivos de ambiente locais)
# ----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template

# Arquivos de injeção de chaves no Flutter (--dart-define-from-file)
dart_defines.json
dart_defines.*.json
env.json
secrets.json
secrets.*.json
config.local.json

# Diretórios de Agentes IA, MCP Servers e credenciais locais (ex: Stitch API Key)
.agents/
.claude/
.cursor/
.gemini/
.windsurf/
mcp_config.json
*mcp_config*.json

# Credenciais Cloud / Firebase / Google / Apple / Assinatura de Apps
key.properties
**/*.keystore
**/*.jks
**/*.p12
**/*.cer
**/*.mobileprovision
google-services.json
GoogleService-Info.plist
ServiceAccountKey.json
*-firebase-adminsdk-*.json

# ----------------------------------------------------------------------------
# 2. Bancos de Dados Locais & Cache de Execução (SQLite / Hive / SharedPrefs)
# ----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
*.hive
*.Boxes
drunk.db

# Exceção explícita: o catálogo seed oficial de bares da cidade DEVE ser versionado
!assets/data/*.json

# ----------------------------------------------------------------------------
# 3. Ambientes Virtuais Python & Scripts Auxiliares (Backend / Automação)
# ----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ----------------------------------------------------------------------------
# 4. Flutter / Dart / Pub / FVM / Build Artifacts
# ----------------------------------------------------------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.fvm/
/build/
/coverage/
lcov.info

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Android / Gradle build & local SDK paths
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle/
/android/captures/
/android/local.properties
/android/GeneratedPluginRegistrant.java
/android/.cxx/

# iOS / macOS / CocoaPods / Ephemeral
**/Pods/
**/Podfile.lock
**/Flutter/ephemeral/
**/flutter/ephemeral/
**/DerivedData/
**/xcuserdata/

# Web / Node / Deploy Tooling
node_modules/
.firebase/
.vercel/
.netlify/

# ----------------------------------------------------------------------------
# 5. IDEs, Editores e Arquivos de Sistema Operacional
# ----------------------------------------------------------------------------
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code
.vscode/

# Arquivos temporários, logs e SO (Linux / macOS / Windows)
*.class
*.log
*.swp
*.swo
*.bak
*.tmp
*.orig
*~
.DS_Store
Thumbs.db
Desktop.ini
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
